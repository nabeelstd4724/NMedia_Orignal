NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Cookie/session settings
AUTH_COOKIE_NAME=nmedia_session
SESSION_TTL_SECONDS=604800
# Playback entitlement defaults
ALLOW_ANONYMOUS_WATCH=true
PAST_DUE_GRACE_DAYS=3
# Advertising controls
ADS_ENABLED=true
MIDROLL_INTERVAL_MIN=12
SKIP_AFTER_SEC=5
MAX_ADS_PER_SESSION=4
# Optional third-party fallback VAST tag. Leave empty for local hosted fixtures.
FALLBACK_VAST_TAG_URL=
# An account registered with this email receives the super_admin role.
SUPER_ADMIN_EMAIL=admin@example.com
# Optional Stripe webhook signing secret. No provider calls are made without an injected gateway.
STRIPE_WEBHOOK_SECRET=
DATABASE_PATH=./data/nmedia.sqlite
MEDIA_ROOT=./data/media
# Replace in production with a randomly generated secret.
HLS_SIGNING_SECRET=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT_BYTES=1048576
